@using Quantify.ViewModels
@model ShowTopicContentViewModel

@{
    ViewData["Title"] = "Show Task Content";
}

<div class="text-start mt-4"><h1>@Model.Name:</h1></div>
<div class="text-start mt-3"><p>@Model.Content</p></div>
<div class="text-center mt-3"><h2>Dostępne zadania:</h2></div>
<div class="text-start mt-3">
    @if(Model.Tasks != null){
        foreach(var task in Model.Tasks){
            <a asp-controller="LearningMaterials" asp-action="ShowTaskContent" asp-route-taskId="@task.TaskId">@task.Contents</a>
        }
    }
</div>
